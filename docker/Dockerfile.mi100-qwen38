# Python requirements: requirements/rocm.txt (includes common.txt), with torch lines stripped and the installed
# torch / Triton / ROCm wheels pinned. Build requirements from requirements/build/rock.txt minus its torch pins
# and its amdsmi pin (amdsmi comes from /opt/rocm above).
RUN set -eu; \
    python tools/use_existing_torch.py; \
    pip install -c /opt/torch-constraints.txt -c /opt/dev-env-lock.txt -r requirements/rocm.txt; \
    pip install -c /opt/torch-constraints.txt -c /opt/dev-env-lock.txt \
        "cmake>=3.26.1,<4" "packaging>=26.2" "setuptools>=78.1.1,<80.0.0" "setuptools-scm>=8" \
        "setuptools-rust>=1.9.0" wheel "jinja2>=3.1.6" ninja tblib; \
    # tilelang declares torch-c-dlpack-ext, but the PyPI wheel is built for stock torch and tvm_ffi cannot use it
    # with the TheRock build (it still falls back, with a warning). The validated environment ran without it.
    pip uninstall -y torch-c-dlpack-ext

# Build and install vLLM in place (editable, as developed here). /opt/rocm/lib is on LD_LIBRARY_PATH only for this
# step (the .def's build environment); the image's runtime environment below leaves it off.
RUN set -eu; \
    if [ "${BUILD_RUST_FRONTEND}" = "1" ]; then export VLLM_REQUIRE_RUST_FRONTEND=1; cargo --version; fi; \
    LD_LIBRARY_PATH=/opt/rocm/lib:/opt/rocm/lib64 MAX_JOBS="${MAX_JOBS}" \
        pip install --no-build-isolation --no-deps -v -e . 2>&1 | tail -n 40; \
    if [ "${BUILD_RUST_FRONTEND}" = "1" ]; then ls -l vllm/vllm-rs; vllm/vllm-rs --help > /dev/null; fi

# ---------------------------------------------------------------------------------------------- runtime environment
# LD_LIBRARY_PATH must not contain /opt/rocm: PyTorch, Triton, RCCL and amdsmi all use the venv's ROCm 10.1 runtime,
# and a second libamdhip64 from /opt/rocm makes Triton refuse to start ("refusing to mix ROCm installations").
ENV LD_LIBRARY_PATH= \
    TORCHINDUCTOR_PERSISTENT_REDUCTIONS=0 \
    HIPCC_COMPILE_FLAGS_APPEND=--rocm-device-lib-path=/opt/venv/lib/python3.12/site-packages/_rocm_sdk_core/lib/llvm/amdgcn/bitcode \
    VLLM_ROCM_USE_AITER=0 \
    HSA_COREDUMP_PATTERN=/tmp/gpucore.%p \
    HF_HOME=/root/.cache/huggingface

# Sanity checks that need no GPU (docker build has none): right Triton/torch builds, the fork's fixes present.
RUN python - <<'EOF'
import importlib.metadata as m
import pathlib
import vllm
root = pathlib.Path(vllm.__file__).parent
assert m.version("triton") == "3.8.0+git3f6e4113.rocm10.1.0a20260822", m.version("triton")
assert m.version("torch") == "2.15.0a0+rocm10.1.0a20260822", m.version("torch")
assert "qwen4_exp_amd_ple_ngram_ids" in (root / "config/compilation.py").read_text(), "ERR-1 fix missing"
spec = (root / "config/speculative.py").read_text()
assert "_yarn_cache_positions" in spec, "upstream YaRN draft rope handling missing (ERR-2/3)"
assert "_maybe_raise_yarn_draft_max_model_len" in spec, "ERR-8 fix missing"
assert "_TAG_PERIOD = (1 << 48) - 1" in (root / "distributed/device_communicators/triton_pcie_collectives.py").read_text(), "48-bit PCIe tags missing"
assert "_pk_sub1032" in (root / "model_executor/layers/fused_moe/wna16_gemv.py").read_text(), "exact MoE GEMV missing"
assert (root / "model_executor/layers/fused_moe/wna16_gemv.py").is_file(), "MI100 MoE decode GEMV missing"
assert (root / "models/qwen4_exp/amd/model.py").is_file(), "Qwen4Exp AMD port missing"
for so in ("_C.abi3.so", "_rocm_C.abi3.so", "_moe_C_stable_libtorch.abi3.so"):
    assert (root / so).is_file(), so
print("vllm", vllm.__version__, "| torch", m.version("torch"), "| triton", m.version("triton"),
      "| rust frontend", (root / "vllm-rs").is_file())
EOF

# ---------------------------------------------------------------------------------------------- launcher
# Recipes from SERVING.md. Usage: serve-qwen38 [tp2pp4|tp2pp4-yarn|tp4pp2] [extra vllm args]
COPY --chmod=755 <<'EOF' /usr/local/bin/serve-qwen38
#!/bin/bash
set -euo pipefail
MODEL=${MODEL:-/models/Qwen3.8-Flash-Next-W4A16}
RECIPE=${1:-tp2pp4}; [ $# -gt 0 ] && shift
export VLLM_PP_DECODE_BALANCE_MIN_REQS=${VLLM_PP_DECODE_BALANCE_MIN_REQS:-2}
SPEC='{"method":"mtp","num_speculative_tokens":2,"use_local_argmax_reduction":true}'
YARN='{"text_config": {"max_position_embeddings": 1048576, "rope_parameters": {"mrope_interleaved": true, "mrope_section": [11, 11, 10], "rope_type": "yarn", "rope_theta": 10000000, "partial_rotary_factor": 0.25, "factor": 4.0, "original_max_position_embeddings": 262144}}}'
case "$RECIPE" in
  tp2pp4)      export VLLM_PP_LAYER_PARTITION=${VLLM_PP_LAYER_PARTITION:-14,14,15,5}
               ARGS=(--tensor-parallel-size 2 --pipeline-parallel-size 4 --max-model-len 262144) ;;
  tp2pp4-yarn) export VLLM_PP_LAYER_PARTITION=${VLLM_PP_LAYER_PARTITION:-14,14,15,5}
               ARGS=(--tensor-parallel-size 2 --pipeline-parallel-size 4 --max-model-len 1000000 --hf-overrides "$YARN") ;;
  tp4pp2)      export VLLM_PP_LAYER_PARTITION=${VLLM_PP_LAYER_PARTITION:-27,21}
               ARGS=(--tensor-parallel-size 4 --pipeline-parallel-size 2 --max-model-len 262144) ;;
  *) echo "unknown recipe '$RECIPE' (tp2pp4 | tp2pp4-yarn | tp4pp2)" >&2; exit 2 ;;
esac
exec vllm serve "$MODEL" --served-model-name qwen38-w4 "${ARGS[@]}" --enable-expert-parallel \
  --limit-mm-per-prompt '{"image":0,"video":0}' --max-num-seqs 64 --gpu-memory-utilization 0.94 \
  --no-enable-prefix-caching --speculative-config "$SPEC" \
  --reasoning-parser qwen3 --tool-call-parser qwen3_coder --enable-auto-tool-choice \
  --trust-remote-code --host 0.0.0.0 --port 8000 "$@"
EOF

EXPOSE 8000
CMD ["serve-qwen38", "tp2pp4"]
