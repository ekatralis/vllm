# syntax=docker/dockerfile:1.7
#
# vLLM for Qwen3.8-Flash-Next (W4A16, Intel AutoRound) on AMD Instinct MI100 (gfx908), 8 GPUs, PCIe only.
#
# Reproduces the environment this branch was developed and evaluated in (an Apptainer image from
# ~/mi100_rocm.def plus the steps in ~/mi100_rocm_additional_commands.txt), with the fixes found on the way:
#   * ROCm 10.3 TheRock tarball in /opt/rocm: compiler and headers for building vLLM's HIP extensions, amd-smi.
#   * PyTorch / torchvision / Triton / ROCm SDK as TheRock multi-arch wheels for gfx908, pinned to the exact
#     builds used here. torch pins triton==3.8.0+git3f6e4113.rocm10.1.0a20260822 itself.
#   * vLLM from the fork, branch mi100-qwen38 (gfx908 kernels, PP fixes, ERR-1/2/3 fixes), editable install.
#   * vLLM's Rust frontend (vllm-rs) built too; it is only used with VLLM_USE_RUST_FRONTEND=1 (off by default).
#   * amdsmi Python bindings wired to the venv's own libamd_smi (one HIP/ROCm runtime per process).
#   * Runtime: /opt/rocm kept OFF LD_LIBRARY_PATH (else Triton refuses to mix two ROCm runtimes), Inductor
#     persistent reductions off, hipcc pointed at the venv's device bitcode (TileLang), AITER off (CDNA3+ only).
#
# Build (needs network; ~1-2 h, most of it the HIP extensions):
#   docker build -f Dockerfile.mi100-qwen38 -t vllm-mi100-qwen38 .            # no build context files needed
#   docker build --build-arg VLLM_REF=<commit> --build-arg MAX_JOBS=64 ...    # pin another commit / more cores
#
# Run (recipe names: tp2pp4 (default, recommended), tp2pp4-yarn (1M context), tp4pp2 (lowest latency, 1-4 users)):
#   docker run --rm -it --network=host --ipc=host --shm-size=64g \
#     --device=/dev/kfd --device=/dev/dri --group-add video --group-add render \
#     --cap-add=SYS_PTRACE --security-opt seccomp=unconfined \
#     -v /models:/models:ro -v vllm-cache:/root/.cache \
#     vllm-mi100-qwen38 serve-qwen38 tp2pp4
#   Extra vllm arguments can follow the recipe name. MODEL=/path overrides the model directory.

FROM ubuntu:24.04

# bash with pipefail: a failing command in a pipe (e.g. the vLLM build piped into tail) must fail the build.
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# ---------------------------------------------------------------------------------------------- versions
ARG GPU_ARCH=gfx908
# ROCm tarball the extensions are compiled against (same as mi100_rocm.def).
ARG ROCM_TARBALL_URL=https://nightly.repo.amd.com/rocm/core/tarball/therock-dist-linux-gfx908-10.3.0a20261031.tar.gz
# ROCm Validation Suite (optional diagnostics, as in mi100_rocm.def). 0 skips it.
ARG INSTALL_RVS=0
ARG RVS_TARBALL_URL=https://stable.repo.amd.com/rocm/extras/rvs/tarball/amdrocm10-rvs-1.6.131-844-Linux.tar.gz
# TheRock wheels. These exact builds are what everything here was validated with; newer nightlies are untested.
ARG TORCH_INDEX_URL=https://rocm.nightlies.amd.com/whl-multi-arch/
ARG TORCH_VERSION=2.15.0a0+rocm10.1.0a20260822
ARG TORCHVISION_VERSION=0.30.0a0+rocm10.1.0a20260822
ARG ROCM_WHEELS_VERSION=10.1.0a20260822
# vLLM source: our fork. VLLM_REF can be a branch, tag or commit (pin a commit for reproducible images).
ARG VLLM_REPO=https://github.com/ekatralis/vllm.git
ARG VLLM_REF=mi100-qwen38
# 1 = build the Rust frontend (vllm-rs) and fail the build if it does not compile; 0 = skip it.
ARG BUILD_RUST_FRONTEND=1
# Parallel compile jobs for the HIP extensions (each takes several GB of RAM).
ARG MAX_JOBS=32

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# ---------------------------------------------------------------------------------------------- system
RUN apt-get update && apt-get install -y --no-install-recommends \
        git cmake build-essential pkg-config libssl-dev ca-certificates wget curl perl \
        python3 python3-venv python3-dev libatomic1 libquadmath0 \
        protobuf-compiler libprotobuf-dev libdrm2 libdrm-amdgpu1 libnuma1 procps \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------------------------- ROCm (TheRock tarball)
RUN set -eu; \
    mkdir -p /opt/rocm; \
    wget -qO /tmp/rocm.tar.gz "${ROCM_TARBALL_URL}"; \
    tar -xzf /tmp/rocm.tar.gz -C /opt/rocm; \
    rm -f /tmp/rocm.tar.gz; \
    ls /opt/rocm/lib/rocblas/library | grep -q "${GPU_ARCH}" \
        || { echo "No ${GPU_ARCH} rocBLAS kernels in this tarball"; exit 1; }; \
    if [ "${INSTALL_RVS}" = "1" ]; then \
        mkdir -p /opt/rocm/extras; \
        wget -qO /tmp/rvs.tar.gz "${RVS_TARBALL_URL}"; \
        tar -xzf /tmp/rvs.tar.gz -C /opt/rocm/extras; \
        rm -f /tmp/rvs.tar.gz; \
    fi

# Build-time ROCm settings
ENV ROCM_PATH=/opt/rocm \
    HIP_PATH=/opt/rocm \
    CMAKE_PREFIX_PATH=/opt/rocm \
    HIPCXX=/opt/rocm/lib/llvm/bin/clang \
    HIP_DEVICE_LIB_PATH=/opt/rocm/lib/llvm/amdgcn/bitcode \
    GPU_ARCH=${GPU_ARCH} \
    PYTORCH_ROCM_ARCH=${GPU_ARCH} \
    VLLM_TARGET_DEVICE=rocm \
    VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:/opt/rocm/extras/bin:/opt/rocm/bin:/opt/rocm/lib/llvm/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# ---------------------------------------------------------------------------------------------- PyTorch (TheRock wheels)
RUN set -eu; \
    python3 -m venv /opt/venv; \
    pip install --upgrade pip; \
    pip install --pre --index-url "${TORCH_INDEX_URL}" \
        "torch[device-${GPU_ARCH}]==${TORCH_VERSION}" \
        "torchvision[device-${GPU_ARCH}]==${TORCHVISION_VERSION}" \
        "rocm[libraries,device-${GPU_ARCH}]==${ROCM_WHEELS_VERSION}"; \
    # Pin exactly what got installed, so no later requirement can swap in a PyPI (CUDA) torch or another Triton.
    pip freeze | grep -iE "^(torch|torchvision|triton|rocm|rocm-sdk-[a-z0-9-]+|rocm-bootstrap|amd-torch[a-z0-9-]*|amd-torchvision[a-z0-9-]*)==" \
        > /opt/torch-constraints.txt; \
    cat /opt/torch-constraints.txt; \
    python -c "import torch, triton; print('torch', torch.__version__, 'hip', torch.version.hip, 'triton', triton.__version__)"

# ---------------------------------------------------------------------------------------------- amdsmi Python bindings
# vLLM's ROCm platform detection uses amdsmi. Use the Python package from /opt/rocm, but load the venv's
# libamd_smi so only the TheRock (venv) ROCm runtime is mapped in the process (mi100_rocm_additional_commands.txt).
RUN set -eu; \
    SITE=$(python -c "import sysconfig; print(sysconfig.get_paths()['purelib'])"); \
    mkdir -p /opt/amdsmi_py; \
    cp -r /opt/rocm/share/amd_smi/amdsmi /opt/amdsmi_py/; \
    ln -sf "${SITE}/_rocm_sdk_core/lib/libamd_smi.so.27" /opt/amdsmi_py/amdsmi/libamd_smi_python.so; \
    echo /opt/amdsmi_py > "${SITE}/amdsmi.pth"; \
    python -c "import amdsmi; print('amdsmi', amdsmi.__file__)"

# ---------------------------------------------------------------------------------------------- Rust toolchain
# The toolchain version comes from vLLM's rust-toolchain.toml (installed on first cargo use in the repo).
ENV RUSTUP_HOME=/opt/rust/rustup \
    CARGO_HOME=/opt/rust/cargo
RUN if [ "${BUILD_RUST_FRONTEND}" = "1" ]; then \
        set -eu; \
        curl -sSfo /tmp/rustup-init https://static.rust-lang.org/rustup/dist/x86_64-unknown-linux-gnu/rustup-init; \
        chmod +x /tmp/rustup-init; \
        /tmp/rustup-init -y --no-modify-path --profile minimal --default-toolchain none; \
        rm -f /tmp/rustup-init; \
    fi
ENV PATH=/opt/rust/cargo/bin:${PATH}

# ---------------------------------------------------------------------------------------------- vLLM (fork)
RUN set -eu; \
    git clone "${VLLM_REPO}" /opt/vllm; \
    cd /opt/vllm; \
    git checkout "${VLLM_REF}"; \
    git log --oneline -1; \
    # Upstream release tags give the version string (0.34.0rc1.devN+g<sha>); a fork clone alone has none.
    git fetch -q https://github.com/vllm-project/vllm.git "refs/tags/*:refs/tags/*"; \
    git describe --tags --abbrev=10 HEAD; \
    # Install the toolchain pinned by rust-toolchain.toml (newer rustup no longer does this on first use).
    if [ "${BUILD_RUST_FRONTEND}" = "1" ]; then rustup toolchain install; rustc --version; fi

WORKDIR /opt/vllm

# Versions of every other Python package, frozen from the environment this branch was validated in
# (2026-11-12, after the rebase onto upstream c674476e2d; minus dev-only extras: AITER and its flydsl, triton_kernels, py-spy). Constraints only pin: packages
# that requirements/rocm.txt no longer needs are not installed. Delete this file's use to take newer versions.
COPY <<'EOF' /opt/dev-env-lock.txt
Jinja2==3.1.6
MarkupSafe==3.0.3
PyJWT==2.15.1
PyYAML==6.0.3
Pygments==2.21.0
accelerate==1.15.0
agent-detector==2.0.0
